---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import T from '../components/i18n/T.astro';
import Loader from '../components/ui/Loader.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact - ${SITE_TITLE}`} description="Get in touch with Cristian about life in rural Japan" />
		<style>
			.contact-container {
				max-width: 600px;
				margin: 0 auto;
				padding: 2rem 1rem;
			}
			
			.contact-title {
				font-size: 2.5rem;
				text-align: center;
				margin-bottom: 2rem;
				color: rgb(var(--black));
				text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
			}
			
			.contact-intro {
				text-align: center;
				margin-bottom: 3rem;
				font-size: 1.1rem;
				line-height: 1.6;
				color: rgb(var(--gray));
			}
			
			.contact-form {
				background-color: var(--secondary);
				padding: 2.5rem;
				border-radius: var(--radius-md);
				box-shadow: var(--box-shadow);
				border: 1px solid var(--secondary);
			}
			
			.form-group {
				margin-bottom: 1.5rem;
			}
			
			.form-label {
				display: block;
				margin-bottom: 0.5rem;
				font-weight: 600;
				color: rgb(var(--black));
				font-size: 1rem;
			}
			
			.form-input,
			.form-textarea {
				width: 100%;
				padding: 0.875rem;
				border: 2px solid rgb(var(--gray));
				border-radius: var(--radius);
				font-size: 1rem;
				font-family: inherit;
				transition: border-color 0.2s ease, box-shadow 0.2s ease;
				background-color: var(--background);
				color: var(--text);
				box-sizing: border-box;
			}
			
			.form-input:focus,
			.form-textarea:focus {
				outline: none;
				border-color: var(--accent);
				box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 10%, transparent);
			}
			
			.form-textarea {
				min-height: 120px;
				resize: vertical;
			}
			
			.submit-button {
				background: var(--accent);
				color: var(--on-pill);
				border: none;
				padding: 0.8rem 2rem;
				font-size: 1.1rem;
				font-weight: 600;
				border-radius: var(--radius);
				cursor: pointer;
				transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
				width: fit-content;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.45rem;
				margin: 0 auto;
			}

			.submit-label {
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}

			.submit-loader {
				display: none;
				align-items: center;
				justify-content: center;
			}
			
			.submit-button:hover {
				background: var(--accent-dark);
				transform: translateY(-2px);
				box-shadow: var(--box-shadow);
			}
			
			.submit-button:disabled {
				background: rgb(var(--gray));
				cursor: not-allowed;
				transform: none;
				box-shadow: none;
			}

			.submit-button.is-loading .submit-loader {
				display: inline-flex;
			}

			.submit-button.is-loading .submit-label {
				opacity: 0.92;
			}

			.submit-loader :global(.garlic-loader) {
				color: white;
			}
			
			.form-message {
				padding: 1rem;
				border-radius: var(--radius);
				margin-bottom: 1rem;
				text-align: center;
				font-weight: 500;
			}
			
			/* Success: Green */
			.form-message.success {
				background-color: var(--success-bg);
				color: var(--success);
				border: 1px solid var(--success);
			}

			/* Error: Red */
			.form-message.error {
				background-color: var(--danger-bg);
				color: var(--danger);
				border: 1px solid var(--danger);
			}

			/* Loading: Blue */
			.form-message.loading {
				background-color: var(--info-bg);
				color: var(--info);
				border: 1px solid var(--info);
			}

			@media (max-width: 600px) {
				.contact-container {
					padding: 1rem 0.5rem;
				}
				
				.contact-title {
					font-size: 2rem;
				}
				
				.contact-form {
					padding: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="contact-container">
				<h1 class="contact-title">
					<T fluid>
						<span slot="en">Contact Me</span>
						<span slot="ja">コンタクト</span>
						<span slot="en_simple">Contact</span>
					</T>
				</h1>
				
				<p class="contact-intro">
					<T fluid>
						<span slot="en">Have a question about life in rural Japan? Want to share your own experiences? I'd love to hear from you!</span>
						<span slot="ja">日本の田舎での生活について質問がありますか？あなたの体験を共有したいですか？お気軽にお声かけください！</span>
						<span slot="en_simple">Do you have a question ? Do you want to share something? Tell me!</span>
					</T>
				</p>
				
				<!-- Form feedback. All messages are rendered up front so the language
				     switcher translates them; the script only toggles [hidden]. -->
				<div class="form-status" role="status" aria-live="polite">
					<div class="form-message error" data-form-message={"required"} hidden>
						<T>
							<span slot="en">Please fill in all required fields.</span>
							<span slot="ja">必須項目をすべて入力してください。</span>
							<span slot="en_simple">Please fill in every box.</span>
						</T>
					</div>
					<div class="form-message error" data-form-message={"email"} hidden>
						<T>
							<span slot="en">Please enter a valid email address.</span>
							<span slot="ja">正しいメールアドレスを入力してください。</span>
							<span slot="en_simple">Please check your email.</span>
						</T>
					</div>
					<div class="form-message success" data-form-message={"sent"} hidden>
						<T>
							<span slot="en">Message sent! I'll get back to you soon.</span>
							<span slot="ja">メッセージを送信しました！近いうちにお返事します。</span>
							<span slot="en_simple">Your message was sent! I'll write back soon.</span>
						</T>
					</div>
					<div class="form-message error" data-form-message={"failed"} hidden>
						<T>
							<span slot="en">Your message didn't send. Please try again.</span>
							<span slot="ja">送信できませんでした。もう一度お試しください。</span>
							<span slot="en_simple">It didn't send. Please try again.</span>
						</T>
					</div>
					<div class="form-message error" data-form-message={"network"} hidden>
						<T>
							<span slot="en">Couldn't connect. Check your internet and try again.</span>
							<span slot="ja">接続できませんでした。インターネット接続を確認して、もう一度お試しください。</span>
							<span slot="en_simple">No internet? Please try again.</span>
						</T>
					</div>
				</div>

				<form class="contact-form" id="contactForm">
					<!-- Web3Forms access key (public by design) -->
					<input type="hidden" name="access_key" value="c276c80a-1816-4287-b0e9-5a7810b1d42d" />
					<!-- Web3Forms honeypot: real users never fill this -->
					<input type="checkbox" name="botcheck" class="sr-only" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
					<div class="form-group">
						<label for="name" class="form-label">
							<T>
								<span slot="en">Name *</span>
								<span slot="ja">お名前 *</span>
								<span slot="en_simple">Name *</span>
							</T>
						</label>
						<input 
							type="text" 
							id="name" 
							name="name" 
							class="form-input" 
							required
							placeholder="Your name"
							data-placeholder-ja="お名前"
							data-placeholder-en_simple="Your name"
						>
					</div>
					
					<div class="form-group">
						<label for="email" class="form-label">
							<T>
								<span slot="en">Email *</span>
								<span slot="ja">メールアドレス *</span>
								<span slot="en_simple">Email *</span>
							</T>
						</label>
						<input 
							type="email" 
							id="email" 
							name="email" 
							class="form-input" 
							required
							placeholder="your.email@example.com"
						>
					</div>
					
					<div class="form-group">
						<label for="subject" class="form-label">
							<T>
								<span slot="en">Subject *</span>
								<span slot="ja">件名 *</span>
								<span slot="en_simple">About *</span>
							</T>
						</label>
						<input 
							type="text" 
							id="subject" 
							name="subject" 
							class="form-input" 
							required
							placeholder="What's this about?"
							data-placeholder-ja="どんな内容ですか？"
							data-placeholder-en_simple="What is it about?"
						>
					</div>
					
					<div class="form-group">
						<label for="message" class="form-label">
							<T>
								<span slot="en">Message *</span>
								<span slot="ja">メッセージ *</span>
								<span slot="en_simple">MESSAGE *</span>
							</T>
						</label>
						<textarea 
							id="message" 
							name="message" 
							class="form-textarea" 
							required
							placeholder="Tell me what's on your mind..."
							data-placeholder-ja="メッセージをどうぞ…"
							data-placeholder-en_simple="Write your message here."
						></textarea>
					</div>
					
					<button type="submit" class="submit-button" id="submitBtn">
						<span class="submit-label">
							<T fluid>
								<span slot="en">Send Message</span>
								<span slot="ja">メッセージを送信</span>
								<span slot="en_simple">SEND</span>
							</T>
						</span>
						<span class="submit-loader" aria-hidden="true">
							<Loader size={12} stepMs={420} />
						</span>
					</button>
				</form>
			</div>
		</main>
		<Footer />
		
		<script>
			type FormMessage = 'required' | 'email' | 'sent' | 'failed' | 'network';

			let hideMessageTimer: number | undefined;

			// Placeholders are attributes, so T slots can't hold them. Inputs keep
			// their English placeholder and carry data-placeholder-ja / -en_simple.
			function applyPlaceholders(lang: string) {
				for (const field of document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#contactForm [placeholder]')) {
					field.dataset.placeholderEn ??= field.placeholder;
					field.placeholder = field.dataset[lang === 'ja' ? 'placeholderJa' : lang === 'en_simple' ? 'placeholderEn_simple' : 'placeholderEn'] ?? field.dataset.placeholderEn;
				}
			}

			function currentLanguage() {
				try {
					return localStorage.getItem('takko-blog-lang') ?? 'en';
				} catch {
					return 'en';
				}
			}

			document.addEventListener('takko:language-changed', (event) => {
				applyPlaceholders((event as CustomEvent<{ lang: string }>).detail?.lang ?? currentLanguage());
			});

			document.addEventListener('astro:page-load', function() {
				const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
				const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
				if (!contactForm || !submitBtn) return;

				applyPlaceholders(currentLanguage());
				contactForm.addEventListener('submit', handleFormSubmit);

				async function handleFormSubmit(e: SubmitEvent) {
					e.preventDefault();

					if (!contactForm || !submitBtn) return;

					// Get form data
					const formData = new FormData(contactForm);
					const data = {
						name: String(formData.get('name') || '').trim(),
						email: String(formData.get('email') || '').trim(),
						subject: String(formData.get('subject') || '').trim(),
						message: String(formData.get('message') || '').trim(),
					};

					// Basic validation
					if (!data.name || !data.email || !data.subject || !data.message) {
						showMessage('required');
						return;
					}

					if (!isValidEmail(data.email)) {
						showMessage('email');
						return;
					}

					showMessage(null);
					setLoading(true);

					try {
						// Submit straight to Web3Forms (all fields, incl. access_key + botcheck honeypot)
						const response = await fetch('https://api.web3forms.com/submit', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json',
								'Accept': 'application/json',
							},
							body: JSON.stringify(Object.fromEntries(formData))
						});

						const result = await response.json() as { success: boolean; message?: string };
						if (result.success) {
							showMessage('sent');
							contactForm.reset();
						} else {
							// Web3Forms' own message is English-only; log it, show ours.
							console.error('Web3Forms error:', result.message);
							showMessage('failed');
						}
					} catch (error) {
						console.error('Error:', error);
						showMessage('network');
					} finally {
						setLoading(false);
					}
				}

				// Errors stay until the next submit; success fades after 5 seconds.
				function showMessage(key: FormMessage | null) {
					window.clearTimeout(hideMessageTimer);
					for (const el of document.querySelectorAll<HTMLElement>('[data-form-message]')) {
						el.hidden = el.dataset.formMessage !== key;
					}
					if (key === 'sent') {
						hideMessageTimer = window.setTimeout(() => showMessage(null), 5000);
					}
				}

				function setLoading(loading: boolean) {
					if (!submitBtn) return;

					submitBtn.disabled = loading;
					submitBtn.setAttribute('aria-busy', String(loading));
					submitBtn.classList.toggle('is-loading', loading);
				}

				function isValidEmail(email: string) {
					const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
					return emailRegex.test(email);
				}
			});
		</script>
	</body>
</html>
