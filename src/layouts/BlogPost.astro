---
import BaseHead from '../components/layout/BaseHead.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FormattedDate from '../components/content/FormattedDate.astro';
import LikeButton from '../components/content/LikeButton.astro';
import TableOfContents from '../components/content/TableOfContents.astro';
import PostContents from '../components/content/PostContents.astro';
import type { TocEntry } from '../lib/post-toc.js';
import OptimizedImage from '../components/media/OptimizedImage.astro';
import T from '../components/i18n/T.astro';
import cameraManifest from '../data/camera-manifest.json';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

type Props = CollectionEntry<'blog'>['data'] & { slug: string; contents?: TocEntry[] };

const {
	title,
	title_ja,
	title_en_simple,
	description,
	pubDate,
	updatedDate,
	heroImage,
	slug,
	heroImageFit,
	heroImageMaxWidth,
	cameraUsedName,
	cameraUsedImage,
	cameraUsedImageAlt,
	cameraUsedLink,
	cameraUsedLinkLabel,
	cameraFallback,
	cameraExclude,
	contents = [],
} = Astro.props as Props;

/*
 * The camera model shown beside the lightbox photo.
 *
 * Astro's sharp service strips EXIF when it generates the avif/webp variants,
 * so the model can never be read in the browser. tools/scripts/build-camera-manifest.mjs
 * reads it from the source images at build time instead, keyed by file stem —
 * the one part of the source filename that survives into `<stem>.<hash>.avif`.
 *
 * Images with no EXIF fall back to the post's own `cameraFallback` (or
 * `cameraUsedName`, for the one post whose header card names the same camera);
 * a photo with neither shows nothing at all and reserves no space.
 *
 * That fallback is why `cameraExclude` exists. Screenshots, diagrams, logos and
 * collages also carry no EXIF, so they are indistinguishable from a photo the
 * optimizer stripped -- and would inherit the fallback and claim to be shot on
 * a camera. Listing their stems in the post's frontmatter opts them out.
 */
const cameraStickers: Record<string, string> = {
	'Olympus Camedia C-840L': '/images/cameras/olympus-c840-sticker-128.webp',
	'Canon PowerShot S90': '/images/cameras/canon-s90-sticker-192.webp',
};
const manifest: Record<string, Record<string, { model: string; lens?: string }>> = cameraManifest;
const camerasByStem = manifest[slug] ?? {};
const lightboxCameras = {
	byStem: camerasByStem,
	fallback: cameraFallback ?? cameraUsedName ?? '',
	stickers: cameraStickers,
	exclude: cameraExclude ?? [],
};
const hasLightboxCameras =
	Boolean(lightboxCameras.fallback) || Object.keys(camerasByStem).length > 0;

function isOptimizedImageSrc(value: unknown): value is ImageMetadata | string {
	if (typeof value === 'string') return true;
	if (!value || typeof value !== 'object') return false;
	const maybeImage = value as Partial<ImageMetadata>;
	return typeof maybeImage.src === 'string';
}

// Resolve a shareable Open Graph image from the hero image (falls back to site default
// in BaseHead). Local images are resized at build time so scrapers don't fetch the
// full-size original; jpg keeps compatibility with every OG consumer.
const ogImage = isOptimizedImageSrc(heroImage)
	? (typeof heroImage === 'string'
		? heroImage
		: (await getImage({ src: heroImage, width: 1200, format: 'jpeg' })).src)
	: undefined;

// A hero set to object-fit: contain leaves empty space beside the image. Instead of
// flat bars, fill it with a tiny, heavily blurred copy of the photo itself. Only for
// local images — a remote/public string src has no build-time resize, so it would mean
// downloading the full-size original a second time just to blur it.
const heroBackdrop =
	heroImageFit === 'contain' && heroImage && typeof heroImage !== 'string' && isOptimizedImageSrc(heroImage)
		? (await getImage({ src: heroImage, width: 160, format: 'webp', quality: 60 })).src
		: undefined;

const heroStyle = [
	heroImageMaxWidth ? `max-width: ${heroImageMaxWidth}` : '',
	heroBackdrop ? `--hero-backdrop: url(${heroBackdrop})` : '',
].filter(Boolean).join('; ') || undefined;
---

<html lang="en" data-random-hue>
	<head>
		<BaseHead
			title={title}
			description={description}
			type="article"
			publishedDate={pubDate}
			updatedDate={updatedDate}
			{...(ogImage && { image: ogImage })}
		/>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
				padding-left: 0;
				padding-right: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 1080px;
				margin: 0 auto 2rem auto;
			}
			@media (max-width: 720px) {
				.hero-image {
					padding: 0 1em;
				}
			}
			/* The <picture> shrink-wraps the img, so it is the frame the backdrop fills. */
			.hero-image :global(picture) {
				display: block;
				width: fit-content;
				margin: 0 auto;
				position: relative;
				overflow: hidden;
				border-radius: var(--radius-md);
				box-shadow: var(--box-shadow);
				background-color: var(--surface);
			}
			.hero-image :global(img) {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-md);
				max-height: 510px;
				object-fit: cover;
				position: relative;
				z-index: 1;
			}
			/* Blurred fill behind a letterboxed hero. Scaled up so the blur's soft edge
			   never reaches the frame. */
			.hero-image.has-backdrop :global(picture)::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image: var(--hero-backdrop);
				background-size: cover;
				background-position: center;
				filter: blur(28px) saturate(1.15);
				transform: scale(1.25);
			}
			/* Knock the blur back so it reads as a surface, not a second photo, and
			   wash it with the page's random --theme-hue so the bars belong to the
			   same palette as the like balloon and the scrapbook tape. */
			.hero-image.has-backdrop :global(picture)::after {
				content: '';
				position: absolute;
				inset: 0;
				background-color: var(--hero-scrim);
				background-image: linear-gradient(var(--hero-tint), var(--hero-tint));
			}
			.hero-image {
				--hero-scrim: rgba(255, 255, 255, 0.14);
				--hero-tint: hsla(var(--theme-hue, 45), 85%, 88%, 0.42);
			}
			:global(.dark) .hero-image {
				--hero-scrim: rgba(0, 0, 0, 0.28);
				--hero-tint: hsla(var(--theme-hue, 45), 60%, 42%, 0.32);
			}
			.prose {
				width: 100%;
				max-width: 720px;
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 0.5em;
				padding: 0.5em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.25em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.post-meta-line {
				margin-top: 0.6rem;
				display: flex;
				justify-content: center;
			}
			.camera-used {
				display: inline-flex;
				align-items: center;
				gap: 0.7rem;
				padding: 0.6rem 0.9rem;
				border-radius: var(--radius-md);
				background: rgba(var(--gray-light), 0.5);
				border: 1px solid rgba(var(--gray), 0.18);
				color: rgb(var(--gray-dark));
				font-size: 1rem;
				line-height: 1.1;
				text-align: left;
				max-width: min(100%, 680px);
			}
			.camera-used__thumb {
				width: 46px;
				height: 46px;
				object-fit: cover;
				border-radius: var(--radius-md);
				flex-shrink: 0;
				/* Light in both themes on purpose: the thumb is a transparent
				   sticker of a (usually black) camera, which a dark chip would hide. */
				background: rgba(255, 255, 255, 0.75);
				border: 1px solid rgba(var(--gray), 0.18);
			}
			.camera-used__label {
				font-weight: 700;
				color: rgb(var(--gray));
				margin-right: 0.15rem;
			}
			.camera-used__name {
				font-weight: 700;
				color: rgb(var(--gray-dark));
			}
			.camera-used__link {
				color: inherit;
				text-decoration: none;
			}
			.camera-used__link:hover .camera-used__name {
				text-decoration: underline;
			}
			@media (max-width: 640px) {
				.camera-used {
					border-radius: var(--radius-md);
					padding: 0.65rem 0.75rem;
					align-items: flex-start;
				}
				.camera-used__copy {
					display: inline-block;
				}
			}
			.last-updated-on {
				font-style: italic;
			}
			.prose :global(figure) {
				margin: 1.8em 0 1.3em 0;
			}
			.prose :global(figure img) {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-md);
				box-shadow: var(--box-shadow);
				max-height: 600px;
				width: auto;
			}
			.prose :global(figcaption) {
				margin-top: 0.75em;
				font-size: 0.875em ;
				color: rgb(var(--gray)) ;
				text-align: center;
				font-style: italic;
				font-weight: 700 ;
				line-height: 1.5;
			}
			.prose :global(figcaption a) {
				white-space: nowrap;
			}
			.prose :global(.scrapbook-container figure) {
				margin: 0;
			}
			.prose :global(.scrapbook-container figure img) {
				border-radius: 0;
				box-shadow: none;
				max-height: none;
				width: 100%;
			}
			.prose :global(.scrapbook-container figure:hover img) {
				width: auto;
				max-height: 60vh;
				box-shadow: 0 15px 40px rgba(0,0,0,0.4);
			}
			.prose[data-blog-content] :global(img:not([data-lightbox="off"])) {
				cursor: zoom-in;
			}
			.lightbox-dialog {
				border: 0;
				/* the UA sheet makes a modal dialog a scroll container; without this
				   the camera rail hanging off the left edge is clipped away */
				overflow: visible;
				padding: 0;
				margin: auto;
				max-width: min(88vw, 1000px);
				max-height: 88vh;
				background: transparent;
			}
			.lightbox-dialog::backdrop {
				background: rgba(0, 0, 0, 0.75);
				backdrop-filter: blur(2px);
			}
			.lightbox-content {
				position: relative;
				background: rgb(var(--gray-dark));
				border-radius: var(--radius-md);
				padding: 1rem;
			}
			.lightbox-content img {
				display: block;
				max-width: min(80vw, 900px);
				max-height: 68vh;
				width: auto;
				height: auto;
				border-radius: var(--radius);
				box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
			}
			/* Fixed light pill, no .dark branch: it sits on the photo over the
			   always-dark ::backdrop (see the camera rail note below). */
			.lightbox-close {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				width: 2.25rem;
				height: 2.25rem;
				border: 1px solid rgba(0, 0, 0, 0.1);
				border-radius: var(--radius-pill);
				background: rgba(255, 255, 255, 0.96);
				color: #222;
				font-size: 1.15rem;
				line-height: 2.2rem;
				text-align: center;
				cursor: pointer;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
				transition: background-color 120ms ease, transform 120ms ease;
			}
			.lightbox-close:hover {
				background: #fff;
				transform: scale(1.04);
			}

			/* ── the camera rail ─────────────────────────────────────────────
			   A sticky note hung in the empty backdrop gutter to the LEFT of the
			   panel, so the photo never moves off centre. A modal dialog is
			   `position: fixed; inset: 0` from the UA sheet and so is already the
			   containing block — do NOT add `position: relative` here, it would
			   override that and break the centring.
			   The ::backdrop is rgba(0, 0, 0, 0.75) in BOTH themes, so this is
			   always a light object on a dark ground: no .dark branch on purpose. */
			.lightbox-camera {
				position: absolute;
				bottom: 1rem;
				right: calc(100% + 1rem);
				display: flex;
				flex-direction: column;
				align-items: flex-end;
				gap: 0.3rem;
				width: 9rem;
				font-size: 0.82rem;
				line-height: 1.35;
			}
			.lightbox-camera[hidden] {
				display: none;
			}
			/* its own object, close to the note but not pasted on it, and the same
			   width so the two read as one stacked column */
			.lightbox-camera__sticker {
				width: 100%;
				height: auto;
				transform: rotate(-4deg);
			}
			.lightbox-camera__sticker[hidden] {
				display: none;
			}
			/* #fbd0d0 is the like balloon's fallback pink, hsl(0, 85%, 90%). The
			   balloon itself uses a random --theme-hue per visit (data-random-hue,
			   set in BaseHead), so the note stays on the fixed pink on purpose.
			   No border — a sticky note has a cut edge, not a drawn one. */
			.lightbox-camera__note {
				width: 100%;
				min-height: 7.25rem;
				padding: 0.85rem 0.7rem 0.7rem;
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				background-color: #fbd0d0;
				color: #4a3636;
				text-align: left;
				transform: rotate(-2.5deg);
				box-shadow:
					4px 4px 0 rgba(0, 0, 0, 0.4),
					0 12px 22px rgba(0, 0, 0, 0.35);
			}
			.lightbox-camera__label {
				opacity: 0.62;
				letter-spacing: 0.02em;
			}
			.lightbox-camera__name {
				font-family: 'Courier New', Courier, monospace;
				font-weight: 700;
			}
			/* only photos that kept their lens EXIF get this second label/name pair */
			.lightbox-camera__lens {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				margin-top: 0.35rem;
			}
			.lightbox-camera__lens[hidden] {
				display: none;
			}
			/* below ~1280px the gutter beside the panel is narrower than the rail,
			   so it drops under the photo and lies down flat */
			@media (max-width: 1280px) {
				.lightbox-camera {
					position: static;
					width: auto;
					margin-top: 0.6rem;
					flex-direction: row;
					align-items: center;
					justify-content: center;
					gap: 0.5rem;
				}
				.lightbox-camera__sticker {
					width: 46px;
				}
				.lightbox-camera__note {
					width: auto;
					min-height: 0;
					flex-direction: row;
					flex-wrap: wrap;
					align-items: baseline;
					gap: 0.35rem;
					padding: 0.45rem 0.7rem;
					transform: rotate(-1.5deg);
				}
				/* a line of its own, so a phone never gets one long run-on note */
				.lightbox-camera__lens {
					flex-basis: 100%;
					flex-direction: row;
					align-items: baseline;
					gap: 0.35rem;
					margin-top: 0;
				}
			}
			.post-outro {
				margin-top: 2.25rem;
				padding: 0.95rem 0.95rem 0.85rem;
				border-radius: var(--radius-lg);
				border: 1px solid rgba(var(--gray), 0.18);
				border-top: 2px solid color-mix(in srgb, var(--accent) 50%, transparent);
				background: rgba(var(--gray-light), 0.28);
				text-align: center;
				box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
			}
			.post-outro__title {
				margin: 0 0 0.45rem 0;
				font-size: 1.15rem;
				font-weight: 800;
				line-height: 1.1;
				color: rgb(var(--gray-dark));
			}
			.post-outro__line {
				margin: 0;
				line-height: 1.5;
				color: rgb(var(--gray-dark));
			}
			.post-outro__line + .post-outro__line {
				margin-top: 0.5rem;
			}
			.post-outro__link {
				display: inline;
				margin: 0 0.18rem;
				padding: 0;
				background: transparent;
				color: var(--accent);
				font-weight: 700;
				text-decoration: underline;
				text-decoration-thickness: 1.5px;
				text-underline-offset: 0.14em;
				transition: opacity 120ms ease;
			}
			.post-outro__link:hover {
				opacity: 0.8;
			}
			.post-outro__link:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
				border-radius: var(--radius-sm);
			}
			/* Background and border follow --gray-light / --gray, which flip in .dark. */
			:global(.dark) .post-outro {
				border-top-color: color-mix(in srgb, var(--accent) 60%, transparent);
				box-shadow: 0 6px 16px rgba(0, 0, 0, 0.14);
			}
			@media (max-width: 640px) {
				.post-outro {
					margin-top: 1.8rem;
					padding: 0.85rem 0.75rem 0.8rem;
					border-radius: var(--radius-md);
				}
				.post-outro__line {
					font-size: 0.95rem;
					line-height: 1.5;
				}
				.post-outro__title {
					font-size: 1.05rem;
				}
			}

		</style>
	</head>

	<body class="blog-post-page">
		<Header />
		
		<main id="top">
			
			<article>
				<div class="prose">
					<div class="title">
						<h1>
							<T>
								<span slot="en" lang="en">{title}</span>
								<span slot="ja" lang="ja" set:html={title_ja || title}></span>
								<span slot="en_simple" lang="en">{title_en_simple || title}</span>
							</T>
						</h1>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										<T fluid>
											<span slot="en" lang="en">Last updated on</span>
											<span slot="ja" lang="ja">最終更新：</span>
											<span slot="en_simple" lang="en">Updated:</span>
										</T>
										<FormattedDate date={updatedDate} />
									</div>
								)
							}
							{
								cameraUsedName && (
									<div class="post-meta-line">
										<div class="camera-used">
											{
												cameraUsedImage && (
													<img
														class="camera-used__thumb"
														src={cameraUsedImage}
														alt={cameraUsedImageAlt || `${cameraUsedName} image`}
														loading="lazy"
														decoding="async"
													/>
												)
											}
											<span class="camera-used__copy">
												<span class="camera-used__label">
													<T>
														<span slot="en" lang="en">Shot with:</span>
														<span slot="ja" lang="ja">撮影機材:</span>
														<span slot="en_simple" lang="en">Camera:</span>
													</T>
												</span>
												{
													cameraUsedLink ? (
														<a
															class="camera-used__link"
															href={cameraUsedLink}
															aria-label={cameraUsedLinkLabel || `Read post about ${cameraUsedName}`}
														>
															<span class="camera-used__name">{cameraUsedName}</span>
														</a>
													) : (
														<span class="camera-used__name">{cameraUsedName}</span>
													)
												}
											</span>
										</div>
									</div>
								)
							}
						</div>
					</div>
				</div>
						{heroImage && isOptimizedImageSrc(heroImage) &&
							<div class:list={['hero-image', heroBackdrop && 'has-backdrop']} style={heroStyle}>
							<OptimizedImage
							  src={heroImage}
					  sizes="(max-width: 960px) 100vw, 960px"
						  alt=""
						  loading="eager"
					  fetchpriority="high"

					  style={heroImageFit && `object-fit: ${heroImageFit}`} />
					</div>
				}
				<PostContents entries={contents} />
				<div class="prose" data-blog-content>
					<slot />
					<div class="post-outro">
						<h3 class="post-outro__title">
							<T fluid>
								<span slot="en" lang="en">Thank you!</span>
								<span slot="ja" lang="ja">ありがとう！</span>
								<span slot="en_simple" lang="en">Thank you!</span>
							</T>
						</h3>
						<p class="post-outro__line">
							<T fluid>
								<span slot="en" lang="en">
									Thank you for reading. Please click on the doggy to leave a like, and go back to the top!
								</span>
								<span slot="ja" lang="ja">
									読んでくれてありがとうございます。わんこをクリックして「いいね」をして、ページの上へ戻ってね！
								</span>
								<span slot="en_simple" lang="en">
									Thank you for reading! Click the doggy to like this post, and go back to the top.
								</span>
							</T>
						</p>
						<p class="post-outro__line">
							<T fluid>
								<span slot="en" lang="en">
									Or click
									<a class="post-outro__link" href="/" aria-label="Return to posts page">here</a>
									to return to the posts page.
								</span>
								<span slot="ja" lang="ja">
									または
									<a class="post-outro__link" href="/" aria-label="記事一覧ページに戻る">ここ</a>
									をクリックして記事一覧ページに戻ってください。
								</span>
								<span slot="en_simple" lang="en">
									Or click
									<a class="post-outro__link" href="/" aria-label="Go back to posts page">here</a>
									to go back to the posts page.
								</span>
							</T>
						</p>
					</div>
				</div>
			</article>
			{slug && <LikeButton slug={slug} />}
			<TableOfContents />
		</main>
		<dialog class="lightbox-dialog" id="post-image-lightbox" aria-label="Expanded image">
			<div class="lightbox-content">
				<button class="lightbox-close" type="button" aria-label="Close image viewer">&times;</button>
				<img alt="" />
			</div>
			{
				hasLightboxCameras && (
					<Fragment>
						<div class="lightbox-camera" hidden>
							<img class="lightbox-camera__sticker" alt="" hidden />
							<div class="lightbox-camera__note">
								<span class="lightbox-camera__label">
									<T>
										<span slot="en" lang="en">Shot with:</span>
										<span slot="ja" lang="ja">撮影機材:</span>
										<span slot="en_simple" lang="en">Camera:</span>
									</T>
								</span>
								<span class="lightbox-camera__name" data-camera-name />
								<span class="lightbox-camera__lens" data-camera-lens hidden>
									<span class="lightbox-camera__label">
										<T>
											<span slot="en" lang="en">Lens:</span>
											<span slot="ja" lang="ja">レンズ:</span>
											<span slot="en_simple" lang="en">Lens:</span>
										</T>
									</span>
									<span class="lightbox-camera__name" data-camera-lens-name />
								</span>
							</div>
						</div>
						{/* is:inline so Astro leaves it alone instead of trying to bundle it as JS */}
						<script
							is:inline
							type="application/json"
							data-camera-manifest
							set:html={JSON.stringify(lightboxCameras).replace(/</g, '\\u003c')}
						/>
					</Fragment>
				)
			}
		</dialog>
		<Footer />
			<script>
				document.addEventListener('astro:page-load', () => {
					const content = document.querySelector('.prose[data-blog-content]');
					const dialogEl = document.getElementById('post-image-lightbox');
					const dialog = dialogEl instanceof HTMLDialogElement ? dialogEl : null;
					const dialogImg = dialog?.querySelector<HTMLImageElement>('.lightbox-content img');
					const dialogCloseBtn = dialog?.querySelector<HTMLButtonElement>('.lightbox-close');

					if (!content || !dialog || !dialogImg) return;

					type CameraData = {
						byStem: Record<string, { model: string; lens?: string }>;
						fallback: string;
						stickers: Record<string, string>;
						exclude: string[];
					};
					const cameraEl = dialog.querySelector<HTMLElement>('.lightbox-camera');
					const cameraNameEl = dialog.querySelector<HTMLElement>('[data-camera-name]');
					const cameraLensEl = dialog.querySelector<HTMLElement>('[data-camera-lens]');
					const cameraLensNameEl = dialog.querySelector<HTMLElement>('[data-camera-lens-name]');
					const cameraStickerEl = dialog.querySelector<HTMLImageElement>('.lightbox-camera__sticker');
					const cameraJson = dialog.querySelector('[data-camera-manifest]')?.textContent;
					let cameraData: CameraData | null = null;
					try {
						cameraData = cameraJson ? (JSON.parse(cameraJson) as CameraData) : null;
					} catch {
						cameraData = null;
					}

					/* Built images are `<stem>.<contenthash>_<hash>.avif`; in dev the same
					   picture comes from `/_image?href=<source path>`. Either way the stem
					   is what the manifest is keyed on. */
					function stemFromSrc(src: string) {
						let path = src;
						try {
							const url = new URL(src, location.href);
							const href = url.searchParams.get('href');
							path = href ? href.split('?')[0] : url.pathname;
						} catch {
							/* not a parseable URL; fall through to the raw string */
						}
						return path.slice(path.lastIndexOf('/') + 1).split('.')[0];
					}

					function showCamera(src: string) {
						if (!cameraData || !cameraEl || !cameraNameEl) return;
						const stem = stemFromSrc(src);
						// checked before the fallback, so an opted-out image shows nothing
						// even on the posts where every other picture names a camera
						const excluded = cameraData.exclude?.includes(stem);
						const model = excluded ? '' : cameraData.byStem[stem]?.model || cameraData.fallback;
						cameraEl.hidden = !model;
						if (!model) return;
						cameraNameEl.textContent = model;
						// the fallback names a camera only, so a lens comes from EXIF or not at all
						const lens = cameraData.byStem[stem]?.lens || '';
						if (cameraLensEl && cameraLensNameEl) {
							cameraLensEl.hidden = !lens;
							cameraLensNameEl.textContent = lens;
						}
						// only some cameras have sticker art; the rest show the note alone
						const sticker = cameraData.stickers[model];
						if (cameraStickerEl) {
							cameraStickerEl.hidden = !sticker;
							if (sticker) cameraStickerEl.src = sticker;
						}
					}

					const excludedSelector = [
						'a',
						'[data-no-lightbox]',
						'[data-lightbox="off"]',
						'.no-lightbox',
						'.scrapbook-container',
					].join(',');

					content.addEventListener('click', (event) => {
						const target = event.target;
						if (!(target instanceof HTMLImageElement)) return;
						if (target.closest(excludedSelector)) return;

						const src = target.currentSrc || target.src;
						dialogImg.src = src;
						dialogImg.alt = target.alt || '';
						showCamera(src);
						dialog.showModal();
					});

					dialog.addEventListener('click', (event) => {
						if (event.target === dialog) {
							dialog.close();
						}
					});

					dialogCloseBtn?.addEventListener('click', () => {
						dialog.close();
					});
				});
			</script>
	</body>
</html>
