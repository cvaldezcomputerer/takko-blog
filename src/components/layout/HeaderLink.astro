---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
// Compare with trailing slashes stripped so "/about" and "/about/" both match
const normalize = (path: string) => (path.length > 1 ? path.replace(/\/+$/, '') : path);
const linkPath = normalize(String(href ?? ''));
const isActive = linkPath === normalize(pathname) || linkPath === '/' + (subpath?.[0] || '');
---

{/*
  Structure + active detection only. The visual treatment (hover/active
  underline) lives in Header.astro alongside the nav layout it depends on —
  Astro forwards the parent's scope id onto this <a>, so styling it from two
  files silently produced dead rules.
*/}
<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
