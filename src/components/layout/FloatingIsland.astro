---
import LanguageSelector from '../i18n/LanguageSelector.astro';
import SettingsCog from '../settings/SettingsCog.astro';

const backLink = '/';
---

<button class="ghost-island" data-target="left" aria-label="Move island left" inert></button>
<button class="ghost-island" data-target="center" aria-label="Move island center" inert></button>
<button class="ghost-island" data-target="right" aria-label="Move island right" inert></button>
<button class="ghost-island" data-target="bottom" aria-label="Move island bottom" inert></button>

<div id="floating-island" data-position="center" inert>
	<a href={backLink} class="island-back-btn" aria-label="Home">
		<svg width="24" height="24" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" d="M4.297105,3.29289 L0.59,7 L4.297105,10.7071 C4.687635,11.0976 5.320795,11.0976 5.711315,10.7071 C6.101845,10.3166 6.101845,9.68342 5.711315,9.29289 L4.418425,8 L11.504215,8 C12.332615,8 13.004215,8.67157 13.004215,9.5 C13.004215,10.3284 12.332615,11 11.504215,11 L10.004215,11 C9.451935,11 9.004215,11.4477 9.004215,12 C9.004215,12.5523 9.451935,13 10.004215,13 L11.504215,13 C13.437215,13 15.004215,11.433 15.004215,9.5 C15.004215,7.567 13.437215,6 11.504215,6 L4.418425,6 L5.711315,4.70711 C6.101845,4.31658 6.101845,3.68342 5.711315,3.29289 C5.320795,2.90237 4.687635,2.90237 4.297105,3.29289 Z"></path></svg>
	</a>
	<LanguageSelector />
	<SettingsCog class="island-settings" size="44px" />
</div>

<style>
	:global(html.island-hidden) #floating-island,
	:global(html.island-hidden) .ghost-island {
		display: none !important;
	}

	#floating-island {
		position: fixed;
		top: 1rem;
		z-index: 101;
		width: max-content;
		max-width: calc(100% - 2rem);
		
		display: flex;
		align-items: center;
		gap: 10rem;
		
		background: var(--secondary);
		box-shadow: 0 8px 32px rgba(0,0,0,0.15);
		border: 4px solid var(--accent);
		border-radius: var(--radius-pill);
		padding: var(--space-2) var(--space-5);
		
		opacity: 0;
		pointer-events: none;
		
		left: 50%;
		top: 1rem;
		transform: translateX(-50%) scale(0.9);
		
		/* GPU acceleration - prevent jitter on mobile */
		will-change: transform, opacity;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		
		
		
		transition: 
			opacity 0.3s ease,
			transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			left 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			top 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			bottom 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
			gap 0.5s ease,
			background-color 0.3s ease,
			border-color 0.3s ease;
	}

	:global(.dark) #floating-island {
		box-shadow: 0 8px 32px rgba(0,0,0,0.5);
	}

	#floating-island.visible {
		opacity: 1;
		pointer-events: auto;
		gap: 0.5rem;
		transform: translateX(-50%) scale(1);
	}
	
	#floating-island[data-position="left"] {
		left: 2rem;
		top: 50%;
		flex-direction: column;
		transform: translate(0, -50%) scale(0.9);
	}
	#floating-island.visible[data-position="left"] {
		transform: translate(0, -50%) scale(1);
	}
	
	#floating-island[data-position="right"] {
		left: 100%;
		top: 50%;
		flex-direction: column;
		transform: translate(calc(-100% - 2rem), -50%) scale(0.9);
	}
	#floating-island.visible[data-position="right"] {
		transform: translate(calc(-100% - 2rem), -50%) scale(1);
	}

	#floating-island[data-position="bottom"] {
		top: auto;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%) scale(0.9);
	}
	#floating-island.visible[data-position="bottom"] {
		transform: translateX(-50%) scale(1);
	}

	#floating-island[data-position="left"] :global(.language-controls),
	#floating-island[data-position="right"] :global(.language-controls) {
		flex-direction: column;
	}

	#floating-island[data-position="left"] :global(.pill-button),
	#floating-island[data-position="right"] :global(.pill-button) {
		width: 100%;
		margin-left: 0;
		margin-top: -1px;
		border-radius: 0;
	}

	#floating-island[data-position="left"] :global(.pill-button:first-child),
	#floating-island[data-position="right"] :global(.pill-button:first-child) {
		border-radius: var(--radius-pill) var(--radius-pill) 0 0;
	}

	#floating-island[data-position="left"] :global(.pill-button:last-child),
	#floating-island[data-position="right"] :global(.pill-button:last-child) {
		border-radius: 0 0 var(--radius-pill) var(--radius-pill);
	}

	.ghost-island {
		position: fixed;
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--surface) 40%, transparent);
		border: 2px dashed rgba(var(--gray), 0.3);
		color: rgba(var(--gray), 0.6);
		
		display: flex;
		align-items: center;
		justify-content: center;
		
		cursor: pointer;
		z-index: 100;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease, transform 0.2s ease, border-color 0.2s, color 0.2s, background-color 0.2s;
		animation: ghostPulse 3s infinite ease-in-out;
	}
	

	.ghost-island:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: var(--surface);
		animation: none;
	}
	:global(.dark) .ghost-island:hover {
		background: var(--highlight);
		border-color: var(--text);
		color: var(--text);
	}
	
	.ghost-island::after {
		content: '+';
		font-size: 1.5rem;
		font-weight: 700;
		padding-bottom: 2px;
	}

	.ghost-island[data-target="left"] { 
		left: 2rem; 
		top: 50%;
		transform: translateY(-50%);
		width: 40px;
		height: 80px;
	}
	.ghost-island[data-target="left"]:hover { transform: translateY(-50%) scale(1.2); }

	.ghost-island[data-target="center"] { 
		left: 50%; 
		top: 2.25rem; 
		transform: translateX(-50%);
		width: 80px;
		height: 40px;
	}
	.ghost-island[data-target="center"]:hover { transform: translateX(-50%) scale(1.2); }
	
	.ghost-island[data-target="right"] { 
		right: 2rem; 
		top: 50%; 
		transform: translateY(-50%); 
		width: 40px; 
		height: 80px; 
	}
	.ghost-island[data-target="right"]:hover { transform: translateY(-50%) scale(1.2); }

	.ghost-island[data-target="bottom"] {
		left: 50%;
		bottom: 2rem;
		transform: translateX(-50%);
		width: 80px;
		height: 40px;
	}
	.ghost-island[data-target="bottom"]:hover { transform: translateX(-50%) scale(1.2); }

	.ghost-island.visible {
		opacity: 1;
		pointer-events: auto;
	}
	.ghost-island.active-pos {
		opacity: 0;
		pointer-events: none;
	}

	#floating-island :global(.language-controls) {
		flex-wrap: nowrap;
	}

	.island-back-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: transparent;
		color: var(--accent);
		transition: transform 0.2s ease;
		margin-left: var(--space-2);
	}
	.island-back-btn:hover {
		transform: scale(1.1);
	}
	.island-back-btn svg,
	.island-back-btn svg path {
		fill: currentColor;
	}

	.island-settings {
		margin-left: 0.5rem;
	}

	@media (max-width: 720px) {
		.ghost-island[data-target="bottom"] {
			display: flex;
		}
		
		.ghost-island[data-target="left"],
		.ghost-island[data-target="right"] {
			display: none;
		}

		#floating-island {
			width: fit-content;
			max-width: 95%;
			padding: 0.5rem 1rem;
			gap: 0.75rem;
			justify-content: center;
		}

		.island-settings {
			margin-left: 0;
		}

		.island-settings :global(.settings-cog) {
			width: 30px;
			height: 30px;
		}

		.island-settings :global(.settings-cog svg) {
			width: 19px;
			height: 19px;
		}

		.island-settings :global(.settings-panel) {
			right: 0;
			min-width: 210px;
		}
		
		#floating-island :global(.pill-button) {
			padding: 0.5rem 0.5rem;
			font-size: 0.8rem;
		}
		
		.island-back-btn {
			width: 32px;
			height: 32px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#floating-island {
			transition: opacity 0.3s ease, background-color 0.3s ease, border-color 0.3s ease;
		}
		.ghost-island {
			animation: none;
		}
	}
</style>

<script>
	type IslandPosition = 'left' | 'center' | 'right' | 'bottom';

	const POSITION_KEY = 'takko-island-position';
	const SHOW_AFTER_SCROLL_PX = 50;
	const MOVE_MS = 500;
	// Half of MOVE_MS, so a slide-out/slide-in move takes as long as a glide.
	const SWAP_HALF_MS = MOVE_MS / 2;

	let cleanupIsland: (() => void) | null = null;

	function isIslandPosition(value: unknown): value is IslandPosition {
		return value === 'left' || value === 'center' || value === 'right' || value === 'bottom';
	}

	function readSavedPosition(): IslandPosition {
		try {
			const saved = localStorage.getItem(POSITION_KEY);
			return isIslandPosition(saved) ? saved : 'center';
		} catch {
			return 'center';
		}
	}

	function savePosition(pos: IslandPosition) {
		try {
			localStorage.setItem(POSITION_KEY, pos);
		} catch {
			// Position just won't persist across pages.
		}
	}

	// The edge the island is pinned to. top <-> bottom can't transition (top goes to auto).
	function anchorOf(pos: IslandPosition) {
		return pos === 'bottom' ? 'bottom' : 'top';
	}

	function isColumn(pos: IslandPosition) {
		return pos === 'left' || pos === 'right';
	}

	function initializeFloatingIsland() {
		cleanupIsland?.();
		cleanupIsland = null;

		const island = document.getElementById('floating-island');
		if (!island) return;
		const ghosts = Array.from(document.querySelectorAll<HTMLElement>('.ghost-island'));
		const mobileQuery = window.matchMedia('(max-width: 720px)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let preferred = readSavedPosition();
		let swapToken = 0;

		// The side ghosts are hidden on mobile, so a saved side position shows at the bottom there.
		function effectivePosition(pos: IslandPosition): IslandPosition {
			return mobileQuery.matches && isColumn(pos) ? 'bottom' : pos;
		}

		function currentPosition(): IslandPosition {
			const pos = island.dataset.position;
			return isIslandPosition(pos) ? pos : 'center';
		}

		function isShown() {
			return island.classList.contains('visible');
		}

		// Leaves CSS transitions alone so an interrupted glide continues from where it is.
		function cancelScriptedAnimations() {
			island.getAnimations({ subtree: true }).forEach(a => {
				if (!(a instanceof CSSTransition)) a.cancel();
			});
		}

		function jumpTo(pos: IslandPosition) {
			island.style.transition = 'none';
			island.dataset.position = pos;
			void island.offsetHeight;
			island.style.transition = '';
		}

		// Slide out past the edge it's heading toward, jump while invisible, slide in from the other side.
		async function slideSwap(pos: IslandPosition) {
			const token = ++swapToken;
			const offset = pos === 'bottom' ? '-150%' : '150%';
			const enterFrom = pos === 'bottom' ? '150%' : '-150%';

			const exit = island.animate(
				[{ translate: '0 0', opacity: 1 }, { translate: `0 ${offset}`, opacity: 0 }],
				{ duration: SWAP_HALF_MS, easing: 'ease-in', fill: 'forwards' }
			);
			try {
				await exit.finished;
			} catch {
				return; // cancelled by a newer move
			}
			if (token !== swapToken) return;

			jumpTo(pos);
			exit.cancel();
			island.animate(
				[{ translate: `0 ${enterFrom}`, opacity: 0 }, { translate: '0 0', opacity: 1 }],
				{ duration: SWAP_HALF_MS, easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)' }
			);
		}

		// Row <-> column reflows the contents instantly; hide them while the box glides so the snap isn't seen.
		function fadeContentsThroughGlide() {
			for (const child of Array.from(island.children)) {
				child.animate(
					[{ opacity: 0 }, { opacity: 0, offset: 0.5 }, { opacity: 1 }],
					{ duration: MOVE_MS, easing: 'ease-out' }
				);
			}
		}

		function syncGhosts() {
			const pos = currentPositionTarget;
			const shown = isShown();
			for (const ghost of ghosts) {
				const isActive = ghost.dataset.target === pos;
				ghost.classList.toggle('visible', shown);
				ghost.classList.toggle('active-pos', isActive);
				ghost.inert = !shown || isActive;
			}
		}

		// Where the island is going, which differs from data-position mid slide-swap.
		let currentPositionTarget = currentPosition();

		function moveTo(pos: IslandPosition) {
			const from = currentPositionTarget;
			currentPositionTarget = pos;
			syncGhosts();
			if (from === pos) return;

			swapToken++;
			cancelScriptedAnimations();

			if (!isShown() || reducedMotion.matches) {
				jumpTo(pos);
			} else if (anchorOf(from) !== anchorOf(pos)) {
				void slideSwap(pos);
			} else {
				if (isColumn(from) !== isColumn(pos)) fadeContentsThroughGlide();
				island.dataset.position = pos;
			}
		}

		function handleScroll() {
			const shown = window.scrollY > SHOW_AFTER_SCROLL_PX;
			if (shown === isShown()) return;

			island.classList.toggle('visible', shown);
			island.inert = !shown;
			syncGhosts();

			// If settings was opened from the island, close it when the island auto-hides.
			if (!shown && island.querySelector('.settings-cog-wrapper.is-open')) {
				document.dispatchEvent(new CustomEvent('takko:settings-close'));
			}
		}

		function handleViewportChange() {
			moveTo(effectivePosition(preferred));
		}

		for (const ghost of ghosts) {
			ghost.addEventListener('click', () => {
				const target = ghost.dataset.target;
				if (!isIslandPosition(target)) return;
				preferred = target;
				savePosition(target);
				moveTo(target);
			});
		}

		currentPositionTarget = effectivePosition(preferred);
		jumpTo(currentPositionTarget);
		syncGhosts();

		window.addEventListener('scroll', handleScroll, { passive: true });
		mobileQuery.addEventListener('change', handleViewportChange);
		cleanupIsland = () => {
			window.removeEventListener('scroll', handleScroll);
			mobileQuery.removeEventListener('change', handleViewportChange);
		};
		handleScroll();
	}

	document.addEventListener('astro:page-load', initializeFloatingIsland);
</script>
