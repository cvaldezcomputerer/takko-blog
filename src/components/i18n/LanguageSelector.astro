---

<div class="language-controls" role="group" aria-label="Content language">
    <button type="button" data-lang-btn="en" class="pill-button active" aria-pressed="true">
      <span class="full-text">English</span>
      <span class="short-text">Eng</span>
    </button>
    <button type="button" data-lang-btn="en_simple" class="pill-button" aria-pressed="false">
      <span class="full-text">Ez English</span>
      <span class="short-text">Easy</span>
    </button>
    <button type="button" data-lang-btn="ja" class="pill-button" aria-pressed="false">
      <span class="full-text">日本語</span>
      <span class="short-text">JP</span>
    </button>
  </div>
  
  <script>
    type Language = "en" | "ja" | "en_simple";
  
    function isLanguage(value: unknown): value is Language {
      return typeof value === "string" && ["en", "ja", "en_simple"].includes(value);
    }
  
    function detectPreferredLanguage(): Language {
      const browserLanguages = Array.isArray(navigator.languages) && navigator.languages.length > 0
        ? navigator.languages
        : [navigator.language];
      const prefersJapanese = browserLanguages.some((lang) =>
        typeof lang === "string" && lang.toLowerCase().startsWith("ja")
      );
      return prefersJapanese ? "ja" : "en";
    }

    // Storage can throw (blocked site data, some private modes); the switcher should still work.
    function readStoredLanguage(key: string): string | null {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    }

    function storeLanguage(key: string, lang: Language) {
      try {
        localStorage.setItem(key, lang);
      } catch {
        // Language just won't persist across pages.
      }
    }

   
    function initializeLanguageSwitcher() {
      const buttons = document.querySelectorAll("[data-lang-btn]");
      const content = document.querySelectorAll("[data-lang-content]");
      const storageKey = "takko-blog-lang";
  
      if (buttons.length === 0) return;
  
      function setLanguage(lang: Language) {
        content.forEach((el) => {
          const isVisible = el.getAttribute("data-lang-content") === lang;
          el.classList.toggle("hidden", !isVisible);
        });
  
        buttons.forEach((btn) => {
          const isActive = btn.getAttribute("data-lang-btn") === lang;
          btn.classList.toggle("active", isActive);
          btn.setAttribute("aria-pressed", String(isActive));
        });

        storeLanguage(storageKey, lang);
        document.dispatchEvent(new CustomEvent("takko:language-changed", { detail: { lang } }));
      }
  
      const savedLang = readStoredLanguage(storageKey);
      const initialLang: Language = isLanguage(savedLang) ? savedLang : detectPreferredLanguage();
      setLanguage(initialLang);
  
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          const langAttr = button.getAttribute("data-lang-btn");
          if (isLanguage(langAttr)) {
            // Avoid View Transition snapshot crossfades for text-only language swaps.
            // The browser crossfade can make glyphs look blurry during the switch.
            setLanguage(langAttr);
          }
        });
      });
    }
  

    document.addEventListener("astro:page-load", initializeLanguageSwitcher);
  </script>
  
  <style>
    .short-text { display: none; }

    .language-controls {
      display: inline-flex;
      justify-content: center;
      gap: 0; 
      margin-block: 0;
      box-shadow: 0 1px 2px rgba(var(--gray), 0.1);
      border-radius: var(--radius-pill);
      
      background-color: rgba(var(--gray), 0.04);
      padding: 0; 
    }

  
    .pill-button {
      -webkit-appearance: none;
      appearance: none;
      background-color: transparent;
      color: rgb(var(--gray)); 
      
      border: 1px solid rgba(var(--gray), 0.3); 
      border-radius: 0; 
      margin-left: -1px; 
      
      font-weight: 600;
      transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
      padding: 0.5rem 1.25rem; 
      font-size: 0.95rem;
      cursor: pointer;
      position: relative; 
      z-index: 1;
    }

    .pill-button[data-lang-btn="en"] { color: var(--pill-en-text); }
    .pill-button[data-lang-btn="en_simple"] { color: var(--pill-ez-text); }
    .pill-button[data-lang-btn="ja"] { color: var(--pill-jp-text); }

    .pill-button:first-child {
      border-top-left-radius: var(--radius-pill);
      border-bottom-left-radius: var(--radius-pill);
      margin-left: 0;
    }
    .pill-button:last-child {
      border-top-right-radius: var(--radius-pill);
      border-bottom-right-radius: var(--radius-pill);
    }

    .pill-button:hover {
      background-color: rgba(var(--gray), 0.12);
      color: rgb(var(--black));
      z-index: 2; 
    }

    .pill-button:focus-visible {
      outline: 2px solid var(--text);
      outline-offset: 2px;
      z-index: 11;
    }


    .pill-button.active {
      z-index: 10; 
      border-color: transparent; 
    }

    .pill-button.active[data-lang-btn="en"] {
      background-color: var(--pill-en);
      color: var(--on-pill);
      box-shadow: 0 2px 8px color-mix(in srgb, var(--pill-en) 30%, transparent);
      border-color: var(--pill-en);
    }

    .pill-button.active[data-lang-btn="en_simple"] {
      background-color: var(--pill-ez);
      color: var(--on-pill);
      box-shadow: 0 2px 8px color-mix(in srgb, var(--pill-ez) 30%, transparent);
      border-color: var(--pill-ez);
    }

    .pill-button.active[data-lang-btn="ja"] {
      background-color: var(--pill-jp);
      color: var(--on-pill);
      box-shadow: 0 2px 8px color-mix(in srgb, var(--pill-jp) 30%, transparent);
      border-color: var(--pill-jp);
    }

    @media (max-width: 1100px) {
      .pill-button {
        padding: 0.35rem 1rem;
        font-size: 0.85rem;
      }
    }
    
    @media (max-width: 600px) {
      .full-text { display: none; }
      .short-text { display: inline; }
      
      .pill-button {
        padding: 0.4rem 0.6rem;
        font-size: 0.8rem;
        flex: 0 0 auto; 
        white-space: nowrap;
      }
    }
  </style>
